<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Gironoid/_Project/UI/USS/GironoidTheme.uss?fileID=7433441132597879392&amp;guid=fc9f20816bcfe4b449526fac985697d0&amp;type=3#GironoidTheme" />

    <ui:VisualElement name="root" class="app-root">

        <!-- TOPBAR -->
        <ui:VisualElement class="topbar panel topbar--decor">
            <ui:VisualElement class="topbar-left">
                <ui:VisualElement name="brandPlate" class="title-plate">
                    <ui:Label name="lblBrand" text="Гироноид" class="brand" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="topbar-center" />

            <ui:VisualElement class="topbar-right">
                <ui:Button name="btnAchievements" text="★" class="icon-btn" />
            </ui:VisualElement>

            <!-- декоративные линии (под стиль из Figma, можно оформить в USS) -->
            <ui:VisualElement class="topbar-decor-lines">
                <ui:VisualElement class="topbar-line topbar-line--a" />
                <ui:VisualElement class="topbar-line topbar-line--b" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- CONTENT -->
        <ui:VisualElement class="content">
            <ui:VisualElement class="center-panel vstack">
                <ui:Button name="btnStarMap" text="Звёздная карта" class="btn" />
                <ui:Button name="btnHangar" text="Ангар" class="btn btn--secondary" />
                <ui:Button name="btnSettings" text="Настройки" class="btn btn--secondary" />

                <ui:Label name="lblEnergy" text="Энергия: --" class="small-text" />
                <ui:Label name="lblEnergyTimer" text="До +1 энергии: --:--" class="small-text" />
                <ui:Label name="lblHint" class="small-text wrap" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="footer" />

        <!-- Tutorial -->
        <ui:VisualElement name="tutorialLayer" class="tutorial-layer" />

    </ui:VisualElement>
</ui:UXML>
