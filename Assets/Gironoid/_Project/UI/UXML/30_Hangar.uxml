                                          style="-unity-text-outline-color: rgba(255, 255, 255, 0.9);" />

                                <ui:VisualElement name="adBanner" class="panel"
                                                  style="height: 120px; background-color: rgba(24, 28, 45, 0.25); border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0);" />

                                <ui:VisualElement style="height: 10px;" />

                                <ui:Button name="btnWatchAd" text="Смотреть рекламу (+10 жетонов)" class="btn btn--secondary"
                                           style="height: 100px; min-height: 100px; white-space: normal; -unity-text-align: middle-center;" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- RIGHT: SHIP ICON PREVIEW -->
                        <ui:VisualElement class="split-col panel"
                                          style="height: 760px; min-width: 420px; background-color: rgba(24, 28, 45, 0); border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0);">
                            <ui:Label text="Превью корабля" class="h2like" style="-unity-text-outline-color: rgba(255, 255, 255, 0.9);" />
                            <ui:VisualElement name="shopShipIconPreview"
